# =============================================================================
# black_glass_candle — ignore rules
#
# Order matters: secret rules first, then build noise, then local state.
# Verify any new rule against a REAL file with:
#     git check-ignore -v --no-index <path>
# (plain `git check-ignore` skips already-tracked paths and will report nothing)
# =============================================================================

# -----------------------------------------------------------------------------
# 0. private/ — ALL personal state lives here, and ONLY here
# -----------------------------------------------------------------------------
# One rule covers everything: deployment config, the feed database, cloned
# third-party apps, generated service configs, logs and backups.
#
# The repo folder contains nothing personal. If you can see it in a fresh
# clone, it was safe to publish; everything else is under private/.
#
#     private/
#     ├── env                  deployment config (passwords, tokens)
#     ├── apps/FreshRSS/       cloned code
#     │   └── data/            ← subscriptions, categories, feeds, read state
#     ├── apps/rss-bridge/
#     │   └── config/config.ini.php
#     ├── etc/                 generated nginx + php-fpm config
#     ├── run/                 unix sockets, pid files
#     ├── logs/
#     └── backups/
#
# CREATE IT FIRST. `git check-ignore` reports "not ignored" for a non-existent
# path when the rule has a trailing slash, so a bare assertion here is a false
# negative. Verified with the directory present.
private/

# Legacy Docker-era paths, kept so an old checkout cannot leak if it is ever
# revived. Harmless if the directories do not exist.
rss-bridge-config/
freshrss-extensions/
freshrss-data/

# -----------------------------------------------------------------------------
# 1. SECRETS — must never be committed
# -----------------------------------------------------------------------------
# The master env file: FreshRSS API password, Instagram burner sessionid,
# GitHub PAT, Cloudflare tunnel token.
#
# NOTE: the live file now lives at private/env. This stays because a stale
# .env at the root would otherwise be committed silently.
.env
.env.*
*.env
!.env.example

# Generic secret containers, in case values get exported during debugging.
secrets/
.secrets/
*.pem
*.key
*.p12
*.kdbx

# RSS-Bridge holds its instance token + bridge credentials in here.
# The .example template IS committed; the live file is not.
rss-bridge-config/config.ini.php
**/config.ini.php
!**/config.ini.php.example

# FreshRSS may be bind-mounted for debugging; it holds config.php + the SQLite DB
# (which contains the user table and API password hash).
freshrss-data/
**/config.php
**/config-user.custom.php
**/users/*/config.php

# -----------------------------------------------------------------------------
# 2. Backups — a dump contains the whole feed DB and every subscription
# -----------------------------------------------------------------------------
backups/
*.opml.bak
*.sqlite.bak
*.tar.gz
!docs/**/*.tar.gz

# -----------------------------------------------------------------------------
# 3. Vendored third-party (re-installed by scripts/install-youlag.sh)
# -----------------------------------------------------------------------------
freshrss-extensions/*
!freshrss-extensions/.gitkeep
!freshrss-extensions/README.md

# -----------------------------------------------------------------------------
# 4. Swift build products (menubar app)
# -----------------------------------------------------------------------------
.build/
build/
*.app/
.swiftpm/
*.xcuserstate
xcuserdata/

# -----------------------------------------------------------------------------
# 5. Docker / runtime state
# -----------------------------------------------------------------------------
docker-compose.override.yml
*.log
logs/
.pids/

# -----------------------------------------------------------------------------
# 6. macOS
# -----------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Icon?
