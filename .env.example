# =============================================================================
# black_glass_candle — environment file (TEMPLATE)
#
#   cp .env.example .env      # then fill in the blanks
#
# `.env` is gitignored. Never commit it. Never paste its contents into a doc,
# an issue, or a chat window.
#
# Generate secrets with:
#   openssl rand -base64 24     # passwords
#   openssl rand -hex 24        # tokens
#
# Sections marked REQUIRED will block `docker compose up` if left empty.
# See docs/inputs_required.md for how to obtain every value.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. HOST
# -----------------------------------------------------------------------------
# IANA timezone. Controls feed timestamps, the `today` filter, and cron.
# Full list: https://www.php.net/timezones
# A wrong TZ does not error — it silently shifts every date by your offset.
TZ=America/Jamaica

# Where the stack runs: local | vps | pi
# Only affects the defaults documented by scripts/, not compose behaviour.
DEPLOY_TARGET=local

# Address the published ports bind to.
#   127.0.0.1  -> this machine only. KEEP THIS for laptop use: it means a café
#                 or hotel network cannot reach your feed reader or its login.
#   0.0.0.0    -> every interface. Only after you have a reverse proxy + firewall.
BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# 2. PORTS
# -----------------------------------------------------------------------------
FRESHRSS_PORT=8080
RSSBRIDGE_PORT=3000

# -----------------------------------------------------------------------------
# 3. FRESHRSS
# -----------------------------------------------------------------------------
# Public URL of the instance. Used for `--base-url` and by the menubar app.
# Keep in sync with BIND_ADDR + FRESHRSS_PORT.
BASE_URL=http://127.0.0.1:8080

FRESHRSS_LANGUAGE=en

# --- Account (created on FIRST RUN ONLY) -------------------------------------
# WARNING: FRESHRSS_INSTALL / FRESHRSS_USER are consumed exactly once, when the
# `freshrss_data` volume is empty. Editing these later has NO effect. To change
# them you must `docker compose down -v` (which deletes every subscription) or
# change the values in the web UI instead.
ADMIN_USER=admin
ADMIN_EMAIL=                                        # REQUIRED
ADMIN_PASSWORD=                                     # REQUIRED  web UI login

# Separate password for the Google Reader API (menubar app + mobile clients).
# Must be at least 8 characters. Deliberately different from ADMIN_PASSWORD:
# it is stored on devices and does not grant full account access.
ADMIN_API_PASSWORD=                                 # REQUIRED  >= 8 chars

# --- Feed refresh ------------------------------------------------------------
# Cron minutes for the built-in refresher. REQUIRED: if you leave this empty the
# cron daemon is disabled and feeds NEVER refresh — the instance looks healthy
# while quietly going stale.
# The upstream docs recommend roughly twice per hour.
CRON_MIN=13,43

# --- Internal network access -------------------------------------------------
# FreshRSS blocks requests to internal hosts by default. Without this, the
# container cannot fetch feeds from the rss-bridge container and every bridged
# subscription will fail with a connection error.
INTERNAL_HOST_ALLOWLIST=rss-bridge:80

# --- Database ----------------------------------------------------------------
# sqlite is the default and is fine for one user. Use pgsql only if you want a
# separate DB service (see docker-compose.db.yml).
DB_TYPE=sqlite                                      # sqlite | pgsql | mysql
DB_HOST=freshrss-db
DB_BASE=freshrss
DB_USER=freshrss
DB_PASSWORD=

# -----------------------------------------------------------------------------
# 4. RSS-BRIDGE
# -----------------------------------------------------------------------------
# Shared secret appended to generated feed URLs as `&token=...`.
# Anyone with this value can read every feed you have configured.
RSSBRIDGE_TOKEN=                                    # REQUIRED

# Allowlist of bridges to expose. Keeping this explicit is a security control:
# RSS-Bridge ships 400+ bridges, several of which make outbound requests.
#
# Contains ONLY names that actually ship with RSS-Bridge. Several names in wide
# circulation do NOT exist (HackerNewsBridge, LemmyBridge, BearBlogBridge,
# GitHubBridge) — an unknown name is ignored silently, so a wrong list fails
# quietly rather than loudly. Verify against the clone's bridges/ directory.
#
# Hacker News no longer has a usable bridge; use the native feed
# https://hnrss.org/frontpage instead. See docs/source_catalog.md.
RSSBRIDGE_ENABLED_BRIDGES=CssSelectorBridge,RedditBridge,FeedMergeBridge,FilterBridge,FeedReducerBridge,GithubReleaseBridge,GithubTrendingBridge

# Some bridges (notably Reddit) are rate-limited by User-Agent. Leave empty to
# use RSS-Bridge's default; set a browser-like string if you get 429s.
RSSBRIDGE_USER_AGENT=

# -----------------------------------------------------------------------------
# 5. MEDIA SOURCES
# -----------------------------------------------------------------------------
# --- Instagram ---------------------------------------------------------------
# BURNER ACCOUNT ONLY. Never your personal account: these cookies are full
# account credentials and will appear in the container's config file.
#
# Obtain: log into the burner in a browser -> DevTools -> Application ->
#         Storage -> Cookies -> https://www.instagram.com
#
# These expire whenever the account logs out or changes password. Expect to
# re-paste them. Set ENABLE_INSTAGRAM=0 to disable without deleting them.
ENABLE_INSTAGRAM=0
INSTAGRAM_SESSIONID=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_CSRFTOKEN=

# --- Reddit ------------------------------------------------------------------
# Only needed if the anonymous bridge gets rate-limited.
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- GitHub ------------------------------------------------------------------
# Classic PAT with `public_repo` and `read:org` ONLY. Nothing else.
# Fine-grained tokens work too; grant read-only repository metadata + contents.
# Used by GitHubBridge to avoid the 60 req/hr anonymous limit.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 6. FORUMS (CSS Selector Bridge)
# -----------------------------------------------------------------------------
# No dedicated bridge exists for most forums, so they are scraped by CSS
# selector. One target per line, pipe-separated:
#
#   NAME|URL|ITEM_SELECTOR|TITLE_SELECTOR|LINK_SELECTOR|DATE_SELECTOR
#
# Get the selectors from DevTools -> Inspect on a thread listing page.
# Leave DATE_SELECTOR empty if the listing has no dates.
# Example:
#   Bluelight|https://www.bluelight.org/xf/forums/trip-reports.44/|.structItem|.structItem-title a|.structItem-title a|time
FORUM_TARGETS=

# -----------------------------------------------------------------------------
# 7. REMOTE ACCESS (optional — only if you read from other devices)
# -----------------------------------------------------------------------------
# Leave SERVER_DNS empty to stay local-only. If set, it must match the hostname
# you will actually type, because FreshRSS stores it in `base_url`.
#
# After enabling API access, verify with the "Check full server configuration"
# link on the Profile page: you want PASS, not Bad Request.
SERVER_DNS=
REVERSE_PROXY=none                                  # none | tailscale | cloudflared | caddy
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# 8. MENUBAR APP
# -----------------------------------------------------------------------------
# Read by scripts/seed_menubar_config.sh, which pushes these into the macOS
# Keychain + app defaults. The Swift app itself never reads .env.
MENUBAR_API_BASE_URL=http://127.0.0.1:8080/api/greader.php
MENUBAR_API_USER=admin
MENUBAR_API_PASSWORD=                               # usually == ADMIN_API_PASSWORD
MENUBAR_REFRESH_SECONDS=300

# -----------------------------------------------------------------------------
# 9. BACKUPS
# -----------------------------------------------------------------------------
# Destination for scripts/backup.sh. Created if missing. Keep it OUTSIDE this
# repo, or inside a path the .gitignore already covers.
BACKUP_DIR=~/Backups/black_glass_candle
BACKUP_KEEP_DAYS=30

# -----------------------------------------------------------------------------
# 10. NOTIFICATIONS (optional)
# -----------------------------------------------------------------------------
# FreshRSS Webhook extension -> Discord. Create at
# Channel -> Integrations -> Webhooks. Anyone with this URL can post to the channel.
DISCORD_WEBHOOK_URL=
