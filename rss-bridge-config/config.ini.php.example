; -----------------------------------------------------------------------------
; Authentication
; -----------------------------------------------------------------------------
; Token auth. Every generated feed URL must carry `&token=<value>`.
;
; This is load-bearing. Without it, RSS-Bridge is an open, unauthenticated URL
; fetcher: anyone who can reach the port can make your container request
; arbitrary URLs and read the result.
;
; Generated from $RSSBRIDGE_TOKEN.
[authentication]

; Set the token to the empty string to disable authentication. Do not.
token = "$RSSBRIDGE_TOKEN"

; -----------------------------------------------------------------------------
; Error reporting
; -----------------------------------------------------------------------------
; "feed"    = errors appear as a single item in the feed (default, noisy)
; "http"    = errors become HTTP status codes (quiet; recommended here)
; "none"    = silent
;
; "feed" is the upstream default and means every transient bridge failure
; becomes a fake article in FreshRSS that you have to mark read. Use "http".
[error]
output = "http"

; How many times an error must recur before it is reported. Reset daily.
report_limit = 3

; -----------------------------------------------------------------------------
; Cache
; -----------------------------------------------------------------------------
; file | sqlite | memcached | array | null
;
; Caching is what stops the upstream sites from banning your IP for hammering
; them. Leave as file unless you have a specific reason.
[cache]
type = "file"

; Seconds. Bridges may override this with their own duration.
; 3600 = one hour, which is comfortably longer than FreshRSS's refresh interval
; (CRON_MIN defaults to twice per hour), so no request is ever wasted.
duration = 3600

; -----------------------------------------------------------------------------
; Bridge allowlist
; -----------------------------------------------------------------------------
; Only these bridges are exposed in the UI and callable by URL.
;
; Least privilege: RSS-Bridge ships 400+ bridges, several of which perform
; server-side outbound requests on your behalf. Enabling all of them with
; `enabled_bridges[] = *` hands that capability to anyone holding the token.
;
; Generated from $RSSBRIDGE_ENABLED_BRIDGES (comma-separated in .env).
; Entries are appended below.
